{
  "openapi": "3.0.1",
  "swagger": "1.0",
  "info": {
    "title": "API Reference",
    "description": {
      "$ref": "./../../common/sso-introduction.md"
    },
    "version": "1.0"
  },
  "servers": [
    {
      "url": "Self-Hosted Server: https://{yourdomain}/reporting/api/site/{tenant-name}"
    }
  ],
  "security": [
    {
      "bearer <token>": []
    }
  ],
  "tags": [
    {
      "name": "SSO Authentication",
      "description": "When signing in to Bold Reports applications using an SSO access token, include the token in the Authorization header. Upon successful validation, Bold Reports issues an encrypted authentication token to enable secure API access.\n"
    }
	],
  "paths": {
    "/token": {
      "post": {
        "tags": [
          "SSO Authentication"
        ],
        "summary": "Azure Entra ID Authentication",
        "description": "Authenticates users using Azure Entra ID (formerly ADFS). Pass the Azure Entra ID access token in the Authorization header. Upon successful validation, Bold Reports issues an encrypted authentication token for secure API access.",
        "operationId": "AzureEntraIDAuthentication",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                    "$ref": "#/components/schemas/ADFS"
                  }
                }
              },
              "required": true
            },
        "responses": {
          "200": {
            "description": "User authenticated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "400": {
            "description": "Bad request or missing parameters.",
            "content": {}
          },
          "401": {
            "description": "Invalid credentials or token.",
            "content": {}
          },
          "404": {
            "description": "User not found.",
            "content": {}
          },
          "405": {
            "description": "Method not allowed.",
            "content": {}
          }
        },
        "security": [
          {
            "bearer <token>": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ADFS": {
        "type": "object",
        "required": [
          "grant_type"
        ],
        "properties": {
          "grant_type": {
            "type": "string",
            "description": "The type of credentials used to authorize the request for an access token.<br />Value allowed is <code>adfs</code>"
          }
        },
        "description": "Schema for ADFS authentication request."
      },
      "Response": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email of the authenticated user."
          },
          "idpreferenceid": {
            "type": "string",
            "description": "Unique identifier for the user.",
            "format": "guid"
          },
          "username": {
            "type": "string",
            "description": "Username of the authenticated user."
          },
          "access_token": {
            "type": "string",
            "description": "Encrypted authentication token."
          },
          "token_type": {
            "type": "string",
            "description": "Type of token issued."
          },
          "expires_in": {
            "type": "integer",
            "description": "Token expiration time in seconds."
          },
          ".issued": {
            "type": "string",
            "description": "Token issue timestamp."
          },
          ".expires": {
            "type": "string",
            "description": "Token expiration timestamp."
          },
          "LoginResult": {
            "type": "boolean",
            "description": "Indicates if login was successful."
          },
          "LoginStatusInfo": {
            "type": "string",
            "description": "Status message from the authentication process."
          }
        },
        "description": "Response schema for successful authentication."
      }
    },
    "securitySchemes": {
      "bearer <token>": {
        "type": "http",
        "description": "JWT token Authentication for ADFS. Required only when `grant_type` is `adfs`.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}